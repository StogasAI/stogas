<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The SDK's implicit FSharp.Core version and bundled package copy change with SDK updates and break locked restores. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <ProjectReference Include="../../bindings/dotnet/Stogas/Stogas.csproj" />
  </ItemGroup>
</Project>
