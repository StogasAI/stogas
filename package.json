{
	"name": "stogas",
	"version": "0.1.0-alpha.1",
	"description": "Stogas SDK for verified confidential AI connections and evidence",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StogasAI/stogas.git"
	},
	"homepage": "https://github.com/StogasAI/stogas#readme",
	"bugs": "https://github.com/StogasAI/stogas/issues",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"files": [
		"bindings/browser",
		"bindings/node",
		"bindings/shared",
		"bindings/worker",
		"pkg/browser",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./bindings/node/node.d.ts",
			"default": "./bindings/node/node.js"
		},
		"./browser": {
			"types": "./bindings/browser/browser.d.ts",
			"default": "./bindings/browser/browser.js"
		},
		"./worker": {
			"types": "./bindings/worker/worker.d.ts",
			"default": "./bindings/worker/worker.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test:browser": "playwright test --config tests/browser/playwright.config.ts",
		"test:worker": "node --test tests/worker/*.test.mjs",
		"test:node": "node --test tests/node/*.test.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "24.19.2",
		"miniflare": "5.20261023.3-beta",
		"openai": "7.47.0",
		"typescript": "7.0.2"
	}
}
