{
	"name": "@stogas/sev-snp",
	"version": "0.1.0-alpha.4",
	"description": "Networkless WebAssembly verification of AMD SEV-SNP attestation reports",
	"keywords": [
		"amd",
		"attestation",
		"confidential-computing",
		"sev-snp",
		"webassembly"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StogasAI/stogas.git",
		"directory": "packages/sev-snp"
	},
	"homepage": "https://github.com/StogasAI/stogas/tree/main/packages/sev-snp#readme",
	"bugs": "https://github.com/StogasAI/stogas/issues",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"files": [
		"bindings",
		"LICENSE",
		"pkg",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./bindings/node/node.d.ts",
			"default": "./bindings/node/node.js"
		},
		"./browser": {
			"types": "./pkg/browser/stogas_sev_snp.d.ts",
			"default": "./pkg/browser/stogas_sev_snp.js"
		},
		"./worker": {
			"types": "./bindings/worker/worker.d.ts",
			"default": "./bindings/worker/worker.js"
		},
		"./package.json": "./package.json"
	}
}
