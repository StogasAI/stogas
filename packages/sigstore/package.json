{
	"name": "@stogas/sigstore",
	"version": "0.1.0-alpha.1",
	"description": "Lightweight networkless WASM verification for GitHub/Sigstore in-toto attestations",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StogasAI/stogas.git",
		"directory": "packages/sigstore"
	},
	"homepage": "https://github.com/StogasAI/stogas/tree/main/packages/sigstore#readme",
	"bugs": "https://github.com/StogasAI/stogas/issues",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"files": [
		"bindings",
		"LICENSE",
		"pkg",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./bindings/node/node.d.ts",
			"default": "./bindings/node/node.js"
		},
		"./browser": {
			"types": "./pkg/browser/stogas_sigstore.d.ts",
			"default": "./pkg/browser/stogas_sigstore.js"
		},
		"./worker": {
			"types": "./bindings/worker/worker.d.ts",
			"default": "./bindings/worker/worker.js"
		},
		"./package.json": "./package.json"
	}
}
