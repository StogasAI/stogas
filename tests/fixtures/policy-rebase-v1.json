{
  "description": "Three-way merges of a policy draft onto a newer saved version. Each section's settings, each rule and $schema merge as units. policy is null when the merge leaves no settings. conflicts and newer are sorted.",
  "cases": [
    {
      "name": "Changes to different settings and rules combine",
      "base": {
        "routing": {
          "retries": 1
        },
        "rules": {
          "night": {
            "when": "a",
            "mode": "default"
          }
        }
      },
      "latest": {
        "routing": {
          "retries": 1
        },
        "rules": {
          "night": {
            "when": "a",
            "mode": "default"
          },
          "eu": {
            "when": "b",
            "routing": {
              "retries": 2
            }
          }
        },
        "timeouts": {
          "totalSeconds": 60
        }
      },
      "draft": {
        "routing": {
          "retries": 1,
          "sort": [
            {
              "by": "price"
            }
          ]
        },
        "rules": {
          "night": {
            "when": "a",
            "mode": "default"
          },
          "large": {
            "when": "c",
            "timeouts": {
              "totalSeconds": 30
            }
          }
        }
      },
      "policy": {
        "routing": {
          "retries": 1,
          "sort": [
            {
              "by": "price"
            }
          ]
        },
        "timeouts": {
          "totalSeconds": 60
        },
        "rules": {
          "night": {
            "when": "a",
            "mode": "default"
          },
          "eu": {
            "when": "b",
            "routing": {
              "retries": 2
            }
          },
          "large": {
            "when": "c",
            "timeouts": {
              "totalSeconds": 30
            }
          }
        }
      },
      "conflicts": [],
      "newer": [
        "rules.eu",
        "timeouts.totalSeconds"
      ]
    },
    {
