    {
      "name": "The fields of an encrypted envelope or a rule never mix",
      "base": {
        "plugins": {
          "redaction": {
            "encrypted": {
              "version": 1,
              "keyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "salt": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA",
              "nonce": "aaaaaaaaaaaaaaaa",
              "blob": "aaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        },
        "rules": {
          "night": {
            "when": "a",
            "routing": {
              "retries": 1
            }
          }
        }
      },
      "latest": {
        "plugins": {
          "redaction": {
            "encrypted": {
              "version": 1,
              "keyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "salt": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbA",
              "nonce": "bbbbbbbbbbbbbbbb",
              "blob": "aaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        },
        "rules": {
