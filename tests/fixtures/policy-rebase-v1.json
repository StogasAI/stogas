              "retries": 1
            }
          }
        }
      },
      "draft": {
        "plugins": {
          "redaction": {
            "encrypted": {
              "version": 1,
              "keyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "salt": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA",
              "nonce": "cccccccccccccccc",
              "blob": "cccccccccccccccccccccccc"
            }
          }
        },
        "rules": {
          "night": {
            "when": "a",
            "routing": {
              "retries": 2
            }
          }
        }
      },
      "policy": {
        "plugins": {
          "redaction": {
            "encrypted": {
              "version": 1,
              "keyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "salt": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA",
              "nonce": "cccccccccccccccc",
              "blob": "cccccccccccccccccccccccc"
            }
          }
        },
        "rules": {
          "night": {
            "when": "a",
            "routing": {
              "retries": 2
            }
          }
        }
      },
      "conflicts": [
        "plugins.redaction",
        "rules.night"
      ],
      "newer": []
    },
    {
